{
  "name": "pro-ai-access",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @pro-ai-access/shared build && pnpm --filter @pro-ai-access/db build && pnpm --filter @pro-ai-access/api build && pnpm --filter @pro-ai-access/admin build && pnpm --filter @pro-ai-access/storefront build",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @pro-ai-access/api dev",
    "dev:admin": "pnpm --filter @pro-ai-access/admin dev",
    "dev:storefront": "pnpm --filter @pro-ai-access/storefront dev",
    "db:generate": "pnpm --filter @pro-ai-access/db generate",
    "db:migrate": "pnpm --filter @pro-ai-access/db migrate:dev",
    "db:deploy": "pnpm --filter @pro-ai-access/db migrate:deploy",
    "db:seed": "pnpm --filter @pro-ai-access/db seed"
  }
}
