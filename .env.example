# ------------------------------------------------------------------
# Premium Hub environment template.
# Copy to .env and fill in real values. NEVER commit .env.
# Generate secrets with:  openssl rand -hex 32
# ------------------------------------------------------------------

NODE_ENV=development

# --- Database -----------------------------------------------------
# Local dev (compose maps postgres to 127.0.0.1:5433):
DATABASE_URL=postgresql://premium_hub:premium_hub@localhost:5433/premium_hub?schema=public
# Inside docker compose the api service overrides this to the postgres service host.
POSTGRES_USER=premium_hub
POSTGRES_PASSWORD=premium_hub
POSTGRES_DB=premium_hub

# --- API ----------------------------------------------------------
API_PORT=3001
PUBLIC_API_URL=https://api.example.com
ADMIN_WEB_URL=https://admin.example.com
# Customer storefront public URL (used for CORS + Zarinpal web return).
STOREFRONT_WEB_URL=https://store.example.com
# URL the admin panel + storefront servers use to reach the API (compose: http://api:3001)
API_INTERNAL_URL=http://localhost:3001

# --- Storefront SMS login (phone OTP) -----------------------------
# driver=log prints the code to the api logs (dev). Set to kavenegar for real SMS.
SMS_DRIVER=log
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Optional Kavenegar OTP template name (verify/lookup API); blank = plain SMS.
KAVENEGAR_OTP_TEMPLATE=
# OTP tuning (optional; sensible defaults applied):
OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Telegram -----------------------------------------------------
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# polling = local dev without a domain, webhook = production
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=https://api.example.com
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
# Comma-separated numeric Telegram IDs with access to /admin quick panel
TELEGRAM_ADMIN_IDS=123456789

# --- Secrets (use different random values for each!) ---------------
JWT_SECRET=replace-with-random-secret
SESSION_SECRET=replace-with-random-secret
ENCRYPTION_KEY=replace-with-random-secret

# --- Initial admin panel owner (seeded once) ------------------------
ADMIN_INITIAL_EMAIL=owner@example.com
ADMIN_INITIAL_PASSWORD=replace-with-strong-password

# --- Money ----------------------------------------------------------
CURRENCY=IRT

# --- Zarinpal (optional until online gateway launch) ----------------
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=https://api.example.com/payments/zarinpal/callback

# --- 3x-ui (Sanaei) panel: automatic VPN provisioning (optional) -----
# Panel base URL including port and secret base path if you use one:
#   https://panel.example.com:2053  or  https://panel.example.com:2053/mysecretpath
XUI_BASE_URL=
# v3 panels (recommended): create a token in panel Settings -> API Tokens.
XUI_API_TOKEN=
# v2 panels only (leave empty when using XUI_API_TOKEN):
XUI_USERNAME=
XUI_PASSWORD=
# Subscription base, e.g. https://panel.example.com:2096/sub  (sub link = base/{subId})
XUI_SUB_BASE_URL=
# Public server address used inside config links; defaults to the panel host.
XUI_PUBLIC_HOST=
